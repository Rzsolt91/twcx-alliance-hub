# Environment — copy to `.env.local` for local `npm run dev`.
# Never commit real keys. `scripts/dev.mjs` will generate the email keys
# locally if they are missing.

# AES-256-GCM key for users.email_encrypted (32 bytes as 64 hex chars).
EMAIL_ENCRYPTION_KEY=

# HMAC-SHA256 key for users.email_lookup_hash (32 bytes as 64 hex chars).
# Must be a different secret from EMAIL_ENCRYPTION_KEY.
EMAIL_HMAC_KEY=

# Discord bot token from the Discord Developer Portal.
# No privileged intents are required. Add the bot to the alliance server so
# it can open a DM channel; reminders are sent with REST only (no gateway).
DISCORD_BOT_TOKEN=

# Same Discord application as the bot. Used for the "Connect Discord" button
# on My settings (OAuth2 identify). Redirect URLs to add in the portal:
#   http://127.0.0.1:8888/api/auth/discord/callback
#   https://twcx-alliance-hub.netlify.app/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional override if the public origin is not the request host.
# Local:  DISCORD_REDIRECT_ORIGIN=http://127.0.0.1:8888
# Live:   DISCORD_REDIRECT_ORIGIN=https://twcx-alliance-hub.netlify.app

# Minutes before an event start to send DMs — hardcoded to 5 in code.
# Do not add a 24/7 cron; the local hub sleeps until T-5 of the next storm.
